{
  "Comment": "Undeploy a running service. Required inputs are AccountCanonicalSlug and ServiceName (to undeploy/destroy ServiceName in AccountCanonicalSlug)",
  "StartAt": "StartUndeploy",
  "States": {
    "StartUndeploy": {
      "Type": "Task",
      "Parameters": {
        "AccountCanonicalSlug.$": "$.AccountCanonicalSlug",
        "ServiceName.$": "$.ServiceName",
        "DeployId.$": "$$.Execution.Name",
        "AllInput.$": "$",
        "Step": "Start",
        "ExecutionArn.$": "$$.Execution.Id"
      },
      "ResultPath": "$.StartResult",
      "Resource": "${undeploy_lambda_arn}",
      "Next": "StartBranch"
    },
    "StartBranch": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.StartResult.Status",
          "StringEquals": "fail",
          "Next": "KnownError"
        },
        {
          "Variable": "$.StartResult.Status",
          "StringEquals": "deploy_active",
          "Next": "HandleConcurrentDeploy"
        },
        {
          "Variable": "$.StartResult.Status",
          "StringEquals": "complete",
          "Next": "Success"
        }
      ],
      "Default": "Report"
    },
    "KnownError": {
      "Type": "Pass",
      "End": true,
      "Parameters": {
        "Status": "fail",
        "Error.$": "$.StartResult.Error",
        "Reported.$": "$.StartResult.Reported"
      }
    },
    "Fail": {
      "Type": "Fail"
    },
    "Success": {
      "Type": "Pass",
      "End": true,
      "Parameters": {
        "Status": "complete",
        "Reported.$": "$.StartResult.Reported"
      }
    },
    "HandleConcurrentDeploy": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.StartResult.OnConcurrentDeploy",
          "StringEquals": "fail",
          "Next": "FailConcurrentDeploy"
        }
      ],
      "Default": "CancelConcurrentDeploy"
    },
    "FailConcurrentDeploy": {
      "Type": "Pass",
      "End": true,
      "Parameters": {
        "Status": "fail",
        "Error": [
          "A deploy is running concurrently, and this undeploy was configured to fail in such a case."
        ],
        "Reported.$": "$.StartResult.Reported"
      }
    },
    "CancelConcurrentDeploy": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "${cancel_deploy_state_machine_arn}",
        "Input": {
          "AccountCanonicalSlug.$": "$.AccountCanonicalSlug",
          "ServiceName.$": "$.ServiceName",
          "Comment.$": "States.Format('Cancelling concurrent deploy of {} in {}', $.ServiceName, $.AccountCanonicalSlug)",
          "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "StepFunctions.ExecutionLimitExceeded"
          ]
        }
      ],
      "ResultPath": null,
      "Next": "StartUndeploy"
    },
    "Report": {
      "Comment": "The ending no Lambda of ours decided: Start answered something nothing matched. Puts the failed event and returns Reported. Takes the whole state, because which fields exist depends on how far the run got. If Report itself fails, the run ends unmarked and the status-event readers report it.",
      "Type": "Task",
      "Parameters": {
        "AllInput.$": "$",
        "ExecutionArn.$": "$$.Execution.Id",
        "Step": "Report"
      },
      "Resource": "${undeploy_lambda_arn}",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "MaxAttempts": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.ReportError",
          "Next": "Fail"
        }
      ],
      "ResultPath": "$.Outcome",
      "Next": "ReportBranch"
    },
    "ReportBranch": {
      "Comment": "Rules run in order, so the BooleanEquals only sees a Reported that exists; a missing path would be States.Runtime.",
      "Type": "Choice",
      "Choices": [
        {
          "Not": {
            "Variable": "$.Outcome.Reported",
            "IsPresent": true
          },
          "Next": "Fail"
        },
        {
          "Variable": "$.Outcome.Reported",
          "BooleanEquals": true,
          "Next": "FailReported"
        }
      ],
      "Default": "Fail"
    },
    "FailReported": {
      "Comment": "Status-event readers skip a FAILED run with this error: deployomat already reported it.",
      "Type": "Fail",
      "Error": "Deployomat.Reported",
      "Cause": "The run failed and deployomat reported it."
    }
  }
}
