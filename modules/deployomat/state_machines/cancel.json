{
  "Comment": "Cancel an in progress deploy. Required inputs are AccountCanonicalSlug and ServiceName (to cancel a deploy of ServiceName in AccountCanonicalSlug)",
  "StartAt": "StartCancel",
  "States": {
    "StartCancel": {
      "Type": "Task",
      "Parameters": {
        "AccountCanonicalSlug.$": "$.AccountCanonicalSlug",
        "ServiceName.$": "$.ServiceName",
        "DeployId.$": "$$.Execution.Name",
        "Step": "Start",
        "AllInput.$": "$",
        "ExecutionArn.$": "$$.Execution.Id"
      },
      "ResultPath": "$.StartResult",
      "Resource": "${cancel_lambda_arn}",
      "Next": "StartBranch"
    },
    "StartBranch": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.StartResult",
          "StringEquals": "fail",
          "Next": "Report"
        },
        {
          "Variable": "$.StartResult",
          "StringEquals": "wait",
          "Next": "PauseForCoalesce"
        },
        {
          "Variable": "$.StartResult",
          "StringEquals": "success",
          "Next": "FinishCancel"
        }
      ],
      "Default": "Report"
    },
    "Fail": {
      "Type": "Fail"
    },
    "PauseForCoalesce": {
      "Comment": "The ALB rule configurations appear to be eventually consistent, this pause seems to be long enough to ensure that the ALB has stopped directing traffic to the ASG we're about to shut down.",
      "Type": "Wait",
      "Seconds": 15,
      "Next": "FinishCancel"
    },
    "FinishCancel": {
      "Type": "Task",
      "Parameters": {
        "AccountCanonicalSlug.$": "$.AccountCanonicalSlug",
        "ServiceName.$": "$.ServiceName",
        "DeployId.$": "$$.Execution.Name",
        "Step": "Finish",
        "AllInput.$": "$",
        "ExecutionArn.$": "$$.Execution.Id"
      },
      "Resource": "${cancel_lambda_arn}",
      "End": true
    },
    "Report": {
      "Comment": "The ending no Lambda of ours decided: Start answered something nothing matched. Puts the failed event and returns Reported. Takes the whole state, because which fields exist depends on how far the run got. If Report itself fails, the run ends unmarked and the status-event readers report it.",
      "Type": "Task",
      "Parameters": {
        "AllInput.$": "$",
        "ExecutionArn.$": "$$.Execution.Id",
        "Step": "Report"
      },
      "Resource": "${cancel_lambda_arn}",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "MaxAttempts": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.ReportError",
          "Next": "Fail"
        }
      ],
      "ResultPath": "$.Outcome",
      "Next": "ReportBranch"
    },
    "ReportBranch": {
      "Comment": "Rules run in order, so the BooleanEquals only sees a Reported that exists; a missing path would be States.Runtime.",
      "Type": "Choice",
      "Choices": [
        {
          "Not": {
            "Variable": "$.Outcome.Reported",
            "IsPresent": true
          },
          "Next": "Fail"
        },
        {
          "Variable": "$.Outcome.Reported",
          "BooleanEquals": true,
          "Next": "FailReported"
        }
      ],
      "Default": "Fail"
    },
    "FailReported": {
      "Comment": "Status-event readers skip a FAILED run with this error: deployomat already reported it.",
      "Type": "Fail",
      "Error": "Deployomat.Reported",
      "Cause": "The run failed and deployomat reported it."
    }
  }
}
