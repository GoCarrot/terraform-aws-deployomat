{
  "Comment": "Deploy a service to an account. Required inputs are AccountCanonicalSlug, ServiceName, and AmiId. Optional inputs are DeployConfig.HealthTimeout, DeployConfig.WaitPerStep, DeployConfig.TrafficShiftPerStep, DeployConfig.BakeTime, and DeployConfig.OnConcurrentDeploy, DeployConfig.SkipNotifications. Each step whose result ends the run puts deployomat's finished deploy event and returns Reported; the rollback after a Catch reports through Report.",
  "StartAt": "StartDeploy",
  "States": {
    "StartDeploy": {
      "Comment": "We take AllInput to extract DeployConfig from it without failing the state machine in the event no DeployConfig is provided.",
      "Type": "Task",
      "Parameters": {
        "AccountCanonicalSlug.$": "$.AccountCanonicalSlug",
        "ServiceName.$": "$.ServiceName",
        "AmiId.$": "$.AmiId",
        "DeployId.$": "$$.Execution.Name",
        "AllInput.$": "$",
        "Step": "Start",
        "ExecutionArn.$": "$$.Execution.Id"
      },
      "ResultPath": "$.StartDeploy",
      "Resource": "${deploy_lambda_arn}",
      "Next": "StartBranch",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.Error",
          "Next": "Rollback"
        }
      ]
    },
    "StartBranch": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.StartDeploy.Status",
          "StringEquals": "fail",
          "Next": "KnownStartError"
        },
        {
          "Variable": "$.StartDeploy.Status",
          "StringEquals": "deploy_active",
          "Next": "HandleConcurrentDeploy"
        },
        {
          "Variable": "$.StartDeploy.Status",
          "StringEquals": "undeploying",
          "Next": "UndeployInProgress"
        },
        {
          "Variable": "$.StartDeploy.Status",
          "StringEquals": "wait_healthy",
          "Next": "CheckHealthy"
        },
        {
          "Variable": "$.StartDeploy.Status",
          "StringEquals": "success",
          "Next": "BakeDeploy"
        }
      ],
      "Default": "Rollback"
    },
    "KnownStartError": {
      "Type": "Pass",
      "Parameters": {
        "Status": "fail",
        "Error.$": "$.StartDeploy.Error",
        "Reported.$": "$.StartDeploy.Reported"
      },
      "ResultPath": "$.Outcome",
      "Next": "ReportBranch"
    },
    "FailConcurrentDeploy": {
      "Type": "Pass",
      "Parameters": {
        "Status": "fail",
        "Error": [
          "A different deploy is running concurrently, and this deploy was configured to fail in such a case."
        ],
        "Reported.$": "$.StartDeploy.Reported"
      },
      "ResultPath": "$.Outcome",
      "Next": "ReportBranch"
    },
    "Fail": {
      "Type": "Fail"
    },
    "UndeployInProgress": {
      "Type": "Pass",
      "Parameters": {
        "Status": "fail",
        "Failed": true,
        "Error.$": "$.StartDeploy.Error",
        "Reported.$": "$.StartDeploy.Reported"
      },
      "ResultPath": "$.Outcome",
      "Next": "ReportBranch"
    },
    "RolledBack": {
      "Comment": "The rollback's own failure, if any, is in the cancel run. Report reads a caught error from $.Error when there is one; it isn't named here because a Choice default reaches Rollback without one.",
      "Type": "Pass",
      "Parameters": {
        "Status": "fail",
        "Failed": true
      },
      "ResultPath": "$.Outcome",
      "Next": "Report"
    },
    "HandleConcurrentDeploy": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.StartDeploy.OnConcurrentDeploy",
          "StringEquals": "fail",
          "Next": "FailConcurrentDeploy"
        }
      ],
      "Default": "CancelConcurrentDeploy"
    },
    "CancelConcurrentDeploy": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "${cancel_deploy_state_machine_arn}",
        "Input": {
          "AccountCanonicalSlug.$": "$.AccountCanonicalSlug",
          "ServiceName.$": "$.ServiceName",
          "Comment.$": "States.Format('Cancelling concurrent deploy of {} in {}', $.ServiceName, $.AccountCanonicalSlug)",
          "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "StepFunctions.ExecutionLimitExceeded"
          ]
        }
      ],
      "ResultPath": null,
      "Next": "StartDeploy"
    },
    "Rollback": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "${cancel_deploy_state_machine_arn}",
        "Input": {
          "AccountCanonicalSlug.$": "$.AccountCanonicalSlug",
          "ServiceName.$": "$.ServiceName",
          "Comment.$": "States.Format('Rolling back deploy of {} in {}', $.ServiceName, $.AccountCanonicalSlug)",
          "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "StepFunctions.ExecutionLimitExceeded"
          ]
        }
      ],
      "ResultPath": null,
      "Next": "RolledBack"
    },
    "RollbackFromCheckHealthy": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "${cancel_deploy_state_machine_arn}",
        "Input": {
          "AccountCanonicalSlug.$": "$.AccountCanonicalSlug",
          "ServiceName.$": "$.ServiceName",
          "Comment.$": "States.Format('Rolling back deploy of {} in {}', $.ServiceName, $.AccountCanonicalSlug)",
          "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "StepFunctions.ExecutionLimitExceeded"
          ]
        }
      ],
      "ResultPath": null,
      "Next": "KnownHealthError"
    },
    "CheckHealthy": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "${loop_wait_state_state_machine_arn}",
        "Input": {
          "AccountCanonicalSlug.$": "$.AccountCanonicalSlug",
          "ServiceName.$": "$.ServiceName",
          "AmiId.$": "$.AmiId",
          "DeployId.$": "$$.Execution.Name",
          "WaitTime.$": "$.StartDeploy.WaitForHealthyTime",
          "TargetGroupArn.$": "$.StartDeploy.NewTargetGroupArn",
          "MinHealthy.$": "$.StartDeploy.MinHealthy",
          "Step": "CheckHealthy",
          "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id",
          "ExecutionArn.$": "$$.Execution.Id",
          "Ami.$": "$.StartDeploy.Ami",
          "SkipNotifications.$": "$.StartDeploy.SkipNotifications"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "StepFunctions.ExecutionLimitExceeded"
          ]
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.Error",
          "Next": "Rollback"
        }
      ],
      "ResultSelector": {
        "Output.$": "$.Output"
      },
      "ResultPath": "$.CheckHealthy",
      "Next": "HealthyBranch"
    },
    "HealthyBranch": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.CheckHealthy.Output.Status",
          "StringEquals": "complete",
          "Next": "Rollout"
        },
        {
          "Variable": "$.CheckHealthy.Output.Status",
          "StringEquals": "deploy_aborted",
          "Next": "CancelledAtCheckHealthy"
        },
        {
          "Variable": "$.CheckHealthy.Output.Status",
          "StringEquals": "fail",
          "Next": "RollbackFromCheckHealthy"
        }
      ],
      "Default": "Rollback"
    },
    "CancelledAtCheckHealthy": {
      "Comment": "Calling a deploy that got cancelled due to a concurrent deploy 'successful' to avoid spurious failure notifications.",
      "Type": "Pass",
      "Parameters": {
        "Status": "deploy_aborted",
        "Error": "Deploy was cancelled due to a superseding deploy.",
        "Reported.$": "$.CheckHealthy.Output.Reported"
      },
      "ResultPath": "$.Outcome",
      "Next": "ReportBranch"
    },
    "KnownHealthError": {
      "Type": "Pass",
      "Parameters": {
        "Status": "fail",
        "Error.$": "$.CheckHealthy.Output.Error",
        "Reported.$": "$.CheckHealthy.Output.Reported"
      },
      "ResultPath": "$.Outcome",
      "Next": "ReportBranch"
    },
    "Rollout": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "${loop_wait_state_state_machine_arn}",
        "Input": {
          "AccountCanonicalSlug.$": "$.AccountCanonicalSlug",
          "ServiceName.$": "$.ServiceName",
          "AmiId.$": "$.AmiId",
          "DeployId.$": "$$.Execution.Name",
          "StepSize.$": "$.StartDeploy.TrafficShiftPerStep",
          "StepDelay.$": "$.StartDeploy.WaitPerStep",
          "RuleIds.$": "$.StartDeploy.RuleIds",
          "TargetGroupArn.$": "$.StartDeploy.NewTargetGroupArn",
          "OldTargetGroupArn.$": "$.StartDeploy.OldTargetGroupArn",
          "Step": "Rollout",
          "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id",
          "ExecutionArn.$": "$$.Execution.Id",
          "Ami.$": "$.StartDeploy.Ami",
          "SkipNotifications.$": "$.StartDeploy.SkipNotifications"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "StepFunctions.ExecutionLimitExceeded"
          ]
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.Error",
          "Next": "Rollback"
        }
      ],
      "ResultSelector": {
        "Output.$": "$.Output"
      },
      "ResultPath": "$.RolloutStatus",
      "Next": "RolloutBranch"
    },
    "RolloutBranch": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.RolloutStatus.Output.Status",
          "StringEquals": "complete",
          "Next": "Coalesce"
        },
        {
          "Variable": "$.RolloutStatus.Output.Status",
          "StringEquals": "deploy_aborted",
          "Next": "CancelledAtRollout"
        }
      ],
      "Default": "Rollback"
    },
    "CancelledAtRollout": {
      "Comment": "Calling a deploy that got cancelled due to a concurrent deploy 'successful' to avoid spurious failure notifications.",
      "Type": "Pass",
      "Parameters": {
        "Status": "deploy_aborted",
        "Error": "Deploy was cancelled due to a superseding deploy.",
        "Reported.$": "$.RolloutStatus.Output.Reported"
      },
      "ResultPath": "$.Outcome",
      "Next": "ReportBranch"
    },
    "Coalesce": {
      "Type": "Task",
      "Parameters": {
        "AccountCanonicalSlug.$": "$.AccountCanonicalSlug",
        "ServiceName.$": "$.ServiceName",
        "AmiId.$": "$.AmiId",
        "DeployId.$": "$$.Execution.Name",
        "TargetGroupArn.$": "$.StartDeploy.NewTargetGroupArn",
        "RuleIds.$": "$.StartDeploy.RuleIds",
        "Step": "Coalesce",
        "ExecutionArn.$": "$$.Execution.Id",
        "Ami.$": "$.StartDeploy.Ami",
        "SkipNotifications.$": "$.StartDeploy.SkipNotifications"
      },
      "ResultPath": "$.Coalesce",
      "Resource": "${deploy_lambda_arn}",
      "Next": "CoalesceBranch",
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.Error",
          "Next": "Rollback"
        }
      ]
    },
    "CoalesceBranch": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.Coalesce.Status",
          "StringEquals": "complete",
          "Next": "BakeDeploy"
        },
        {
          "Variable": "$.Coalesce.Status",
          "StringEquals": "deploy_aborted",
          "Next": "CancelledAtCoalesce"
        }
      ],
      "Default": "Rollback"
    },
    "CancelledAtCoalesce": {
      "Comment": "Calling a deploy that got cancelled due to a concurrent deploy 'successful' to avoid spurious failure notifications.",
      "Type": "Pass",
      "Parameters": {
        "Status": "deploy_aborted",
        "Error": "Deploy was cancelled due to a superseding deploy.",
        "Reported.$": "$.Coalesce.Reported"
      },
      "ResultPath": "$.Outcome",
      "Next": "ReportBranch"
    },
    "BakeDeploy": {
      "Type": "Task",
      "Resource": "arn:aws:states:::states:startExecution.sync:2",
      "Parameters": {
        "StateMachineArn": "${loop_wait_state_state_machine_arn}",
        "Input": {
          "AccountCanonicalSlug.$": "$.AccountCanonicalSlug",
          "ServiceName.$": "$.ServiceName",
          "AmiId.$": "$.AmiId",
          "DeployId.$": "$$.Execution.Name",
          "TargetGroupArn": "$.StartDeploy.NewTargetGroupArn",
          "RuleIds.$": "$.StartDeploy.RuleIds",
          "BakeTime.$": "$.StartDeploy.WaitForBakeTime",
          "Step": "Bake",
          "AWS_STEP_FUNCTIONS_STARTED_BY_EXECUTION_ID.$": "$$.Execution.Id",
          "ExecutionArn.$": "$$.Execution.Id",
          "Ami.$": "$.StartDeploy.Ami",
          "SkipNotifications.$": "$.StartDeploy.SkipNotifications"
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "StepFunctions.ExecutionLimitExceeded"
          ]
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.Error",
          "Next": "Rollback"
        }
      ],
      "ResultSelector": {
        "Output.$": "$.Output"
      },
      "ResultPath": "$.BakeStatus",
      "Next": "BakeBranch"
    },
    "BakeBranch": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.BakeStatus.Output.Status",
          "StringEquals": "complete",
          "Next": "FinishDeploy"
        },
        {
          "Variable": "$.BakeStatus.Output.Status",
          "StringEquals": "deploy_aborted",
          "Next": "CancelledAtBake"
        }
      ],
      "Default": "Rollback"
    },
    "CancelledAtBake": {
      "Comment": "Calling a deploy that got cancelled due to a concurrent deploy 'successful' to avoid spurious failure notifications.",
      "Type": "Pass",
      "Parameters": {
        "Status": "deploy_aborted",
        "Error": "Deploy was cancelled due to a superseding deploy.",
        "Reported.$": "$.BakeStatus.Output.Reported"
      },
      "ResultPath": "$.Outcome",
      "Next": "ReportBranch"
    },
    "FinishDeploy": {
      "Type": "Task",
      "Parameters": {
        "AccountCanonicalSlug.$": "$.AccountCanonicalSlug",
        "ServiceName.$": "$.ServiceName",
        "DeployId.$": "$$.Execution.Name",
        "AllowUndeploy.$": "$.StartDeploy.AllowUndeploy",
        "AutomaticUndeployMinutes.$": "$.StartDeploy.AutomaticUndeployMinutes",
        "Step": "Finish",
        "ExecutionArn.$": "$$.Execution.Id",
        "Ami.$": "$.StartDeploy.Ami",
        "SkipNotifications.$": "$.StartDeploy.SkipNotifications",
        "AmiId.$": "$.AmiId"
      },
      "Resource": "${deploy_lambda_arn}",
      "ResultPath": "$.Outcome",
      "Next": "ReportBranch"
    },
    "Report": {
      "Comment": "Only after Rollback: the run rolled back after a Catch or an unmatched status, and no Lambda of ours decided that. Puts the failed event with the caught error. Takes the whole state, because which fields exist depends on how far the run got. An old Lambda that doesn't know this step returns no Reported, which ends the run unreported.",
      "Type": "Task",
      "Parameters": {
        "AllInput.$": "$",
        "ExecutionArn.$": "$$.Execution.Id",
        "Step": "Report"
      },
      "Resource": "${deploy_lambda_arn}",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "MaxAttempts": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "ResultPath": "$.ReportError",
          "Next": "Unreported"
        }
      ],
      "Next": "ReportBranch",
      "ResultPath": "$.Outcome"
    },
    "ReportBranch": {
      "Comment": "Every ending comes here with its step's Reported in $.Outcome. Rules run in order, so the BooleanEquals only sees a Reported that exists; a missing path would be States.Runtime.",
      "Type": "Choice",
      "Choices": [
        {
          "Not": {
            "Variable": "$.Outcome.Reported",
            "IsPresent": true
          },
          "Next": "Unreported"
        },
        {
          "Variable": "$.Outcome.Reported",
          "BooleanEquals": true,
          "Next": "Reported"
        }
      ],
      "Default": "Unreported"
    },
    "Reported": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.Outcome.Failed",
          "IsPresent": true,
          "Next": "FailReported"
        }
      ],
      "Default": "ReportedOutcome"
    },
    "ReportedOutcome": {
      "Type": "Pass",
      "OutputPath": "$.Outcome",
      "End": true
    },
    "FailReported": {
      "Comment": "Status-event readers skip a FAILED run with this error: deployomat already reported it.",
      "Type": "Fail",
      "Error": "Deployomat.Reported",
      "Cause": "The deploy failed and deployomat reported it."
    },
    "Unreported": {
      "Comment": "Nothing was reported, or Report itself failed. End the way the run would have without it, unmarked, so status-event readers report it.",
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.Outcome.Failed",
          "IsPresent": true,
          "Next": "Fail"
        }
      ],
      "Default": "UnreportedOutcome"
    },
    "UnreportedOutcome": {
      "Type": "Pass",
      "OutputPath": "$.Outcome",
      "End": true
    }
  }
}
